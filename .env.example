# Copie para .env para mudar a câmera usada pelo docker compose.
#
# Padrão: webcam do PC, transmitida pelo tools/webcam_server.py (o start.bat liga sozinho)
# CAMERA_SOURCE=http://host.docker.internal:8090/video
#
# Celular com DroidCam (mesmo Wi-Fi):
# CAMERA_SOURCE=http://192.168.0.10:4747/video
#
# Câmera IP com RTSP:
# CAMERA_SOURCE=rtsp://usuario:senha@192.168.0.20:554/stream
#
# FPS real da câmera (streams costumam informar errado)
# CAMERA_FPS=30
